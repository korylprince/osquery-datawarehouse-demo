{
  "datasets": [
    {
      "database_name": "Trino",
      "schema": "default",
      "table_name": "osquery_os_version_per_day",
      "kind": "virtual",
      "sql": "WITH latest_per_day AS (\n    SELECT\n      DATE_TRUNC('DAY', CAST(meta_time AS TIMESTAMP)) AS meta_time,\n      decoration_serial,\n      version,\n      ROW_NUMBER() OVER (\n        PARTITION BY decoration_serial, DATE_TRUNC('DAY', CAST(meta_time AS TIMESTAMP))\n        ORDER BY meta_time DESC\n      ) AS rn\n    FROM iceberg.default.osquery_os_version\n  )\n  SELECT\n    meta_time,\n    version,\n    decoration_serial\n  FROM latest_per_day\n  WHERE rn = 1",
      "main_dttm_col": "meta_time"
    }
  ],
